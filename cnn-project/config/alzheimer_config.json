{
  "disease": "Alzheimer",
  "description": "Alzheimer MRI Classification - 4 Classes (NonDemented, VeryMildDemented, MildDemented, ModerateDemented)",
  
  "data": {
    "img_size": 224,
    "batch_size": 32,
    "val_split": 0.15,
    "seed": 42
  },
  
  "model": {
    "name": "EfficientNet-B0",
    "type": "transfer_learning",
    "architecture": "efficientnet_b0",
    "num_classes": 4,
    "classes": ["NonDemented", "VeryMildDemented", "MildDemented", "ModerateDemented"],
    "dropout": 0.4,
    "epochs": 17,
    "learning_rate": 1e-4,
    "patience": 7,
    "weight_decay": 1e-4,
    "primary_metric": "macro_f1",
    "note": "Imbalanced dataset - use Macro F1 as primary metric"
  },
  
  "device": "cuda",
  "augmentation": {
    "train": {
      "crop_range": [20],
      "horizontal_flip": 0.5,
      "rotation": 15,
      "color_jitter": {"brightness": 0.2, "contrast": 0.2, "saturation": 0.1},
      "grayscale": 0.05,
      "random_erasing": {"p": 0.2, "scale": [0.02, 0.1]}
    }
  },
  
  "imagenet_norm": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "paths": {
    "data_root": "data/DATASET/alz/Combined Dataset",
    "results_root": "results/Alzheimer",
    "weights": "results/Alzheimer/weights/model_efficientnet_b0.pth",
    "history": "results/Alzheimer/history/history.json",
    "plots": "results/Alzheimer/plots",
    "confusion_matrix": "results/Alzheimer/confusion_matrix/confusion_matrix.png"
  }
}
